{
  "name": "caruso-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de gestión de alquileres de Caruso Propiedades",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/domain",
    "test:rules": "firebase emulators:exec --only firestore --project demo-caruso \"vitest run tests/rules\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-caruso \"node tests/e2e/flujo-usuarios.mjs\""
  },
  "dependencies": {
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "playwright": "^1.56.0"
  }
}
